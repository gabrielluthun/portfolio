---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FadeIn from "../../components/FadeIn.tsx";
import ProjectGrid from "../../components/projects/ProjectGrid.tsx";
import { findAllProjects } from "../../data/repositories/project.repository";

const projects = findAllProjects();
---

<BaseLayout
  title="Projets — Gabriel Luthun"
  description="Catalogue des projets présentés sur le portfolio."
>
  <section class="mx-auto max-w-6xl px-6 py-24">
    <FadeIn client:visible />
    <h1 class="mb-4">Projets</h1>
    <p class="mb-12">
      Études de cas : web, mobile et desktop.
    </p>
    <ProjectGrid
      client:visible
      projects={projects}
      baseUrl={import.meta.env.BASE_URL}
    />
  </section>
</BaseLayout>
