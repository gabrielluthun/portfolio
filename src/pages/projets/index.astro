---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectGrid from "../../components/projects/ProjectGrid.tsx";
import { findAllProjects } from "../../data/repositories/project.repository";
import { t } from "../../i18n/t";

const locale = "fr";
const projects = findAllProjects(locale);
---

<BaseLayout
  title="Projets — Gabriel Luthun"
  description="Catalogue des projets présentés sur le portfolio."
>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
    <h1 class="mb-4">{t(locale, "projects.title")}</h1> <br>
    <ProjectGrid
      client:visible
      projects={projects}
      baseUrl={import.meta.env.BASE_URL}
      locale={locale}
      projectsBasePath="projets"
    />
  </section>
</BaseLayout>
