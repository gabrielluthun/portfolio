---
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SmoothScroll from "../components/SmoothScroll.tsx";
import BackToTop from "../components/BackToTop.tsx";
import { sitePath } from "../lib/site-path";
import { getLocaleFromPathname, type Locale } from "../i18n/locales";
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
  locale?: Locale;
};

const {
  title = "Gabriel Luthun — Portfolio",
  description = "Je construis des outils web performants, pensés pour vos utilisateurs et votre business.",
  locale = getLocaleFromPathname(Astro.url.pathname),
} = Astro.props;
const favicon = sitePath("favicon.svg", import.meta.env.BASE_URL);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      const themeKey = "theme";
      const applyStoredTheme = () => {
        const stored = localStorage.getItem(themeKey);
        document.documentElement.classList.toggle(
          "dark",
          stored !== "light",
        );
      };
      applyStoredTheme();
      document.addEventListener("astro:after-swap", applyStoredTheme);
    </script>
    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col bg-bg text-fg">
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-accent focus:px-3 focus:py-2 focus:text-accent-fg"
    >
      {locale === "fr" ? "Aller au contenu" : "Skip to content"}
    </a>
    <SmoothScroll client:load />
    <BackToTop client:load />
    <Header locale={locale} />
    <main id="contenu" class="flex-1" transition:animate="fade">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
