---
import { sitePath } from "../lib/site-path";

const privacy = sitePath("confidentialite", import.meta.env.BASE_URL);
const legal = sitePath("mentions-legales", import.meta.env.BASE_URL);
const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-border">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-10 sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <p class="m-0 text-sm text-fg-muted">© {year} Gabriel Luthun</p>
    <ul class="m-0 flex list-none flex-wrap gap-4 p-0 text-sm">
      <li>
        <a href="https://github.com/gabrielluthun" rel="noreferrer noopener" target="_blank">GitHub</a>
      </li>
      <li>
        <a href="https://www.linkedin.com/in/gabriel-luthun" rel="noreferrer noopener" target="_blank">LinkedIn</a>
      </li>
      <li>
        <a href="mailto:gabriel.luthun@gmail.com">E-mail</a>
      </li>
      <li>
        <a href={privacy}>Confidentialité</a>
      </li>
      <li>
        <a href={legal}>Mentions légales</a>
      </li>
    </ul>
  </div>
</footer>
