---
import HeroTypewriter from "./HeroTypewriter.tsx";
import { sitePath } from "../../lib/site-path";

const home = sitePath("", import.meta.env.BASE_URL);
const portrait = sitePath("assets/portrait.png", import.meta.env.BASE_URL);
---

<section class="relative mx-auto flex min-h-[calc(100svh-80px)] max-w-6xl items-center px-4 py-12 sm:min-h-[calc(100svh-88px)] sm:px-6">
  <div class="flex w-full flex-col items-center gap-8 sm:gap-12 md:flex-row md:items-center md:justify-between md:gap-16">
    <div class="min-w-0 w-full md:flex-1">
      <HeroTypewriter client:load />
      <div class="mt-8 flex flex-wrap gap-3 sm:mt-10 sm:gap-4">
        <a
          href={`${home}#projets`}
          class="rounded-md bg-accent px-4 py-2.5 text-sm font-medium text-accent-fg no-underline hover:bg-accent-hover hover:text-accent-fg sm:px-5 sm:py-3"
        >
          Voir mes réalisations
        </a>
        <a
          href={`${home}#contact`}
          class="rounded-md border border-border px-4 py-2.5 text-sm font-medium text-fg no-underline hover:border-accent hover:text-accent sm:px-5 sm:py-3"
        >
          Me contacter
        </a>
      </div>
    </div>
    <img
      src={portrait}
      alt="Portrait de Gabriel Luthun"
      width="288"
      height="288"
      fetchpriority="high"
      class="h-36 w-36 shrink-0 overflow-hidden rounded-full object-cover sm:h-48 sm:w-48 md:h-72 md:w-72"
    />
  </div>
  <a
    href={`${home}#profil`}
    aria-label="Aller à la section Profil"
    class="absolute bottom-5 left-1/2 inline-flex -translate-x-1/2 items-center justify-center rounded-full border border-border bg-bg/60 p-2 text-fg-muted no-underline backdrop-blur-sm transition hover:border-accent hover:text-accent"
  >
    <svg
      aria-hidden="true"
      class="h-5 w-5 animate-bounce"
      viewBox="0 0 20 20"
      fill="currentColor"
    >
      <path
        fill-rule="evenodd"
        d="M10 3.25a.75.75 0 0 1 .75.75v9.19l3.72-3.72a.75.75 0 1 1 1.06 1.06l-5 5a.75.75 0 0 1-1.06 0l-5-5a.75.75 0 0 1 1.06-1.06l3.72 3.72V4a.75.75 0 0 1 .75-.75Z"
        clip-rule="evenodd"
      />
    </svg>
  </a>
</section>
