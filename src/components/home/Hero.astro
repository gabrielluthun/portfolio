---
import FadeIn from "../FadeIn.tsx";
import { sitePath } from "../../lib/site-path";

const home = sitePath("", import.meta.env.BASE_URL);
const projets = sitePath("projets", import.meta.env.BASE_URL);
---

<section class="mx-auto max-w-6xl px-6 pb-8 pt-24 sm:pt-32">
  <FadeIn client:visible />
  <p class="mb-4 text-sm font-medium tracking-wide text-accent uppercase">
    Concepteur et développeur d'applications
  </p>
  <h1 class="max-w-4xl">[À DÉFINIR]</h1>
  <p class="mt-6 max-w-xl text-lg">
    Conception et développement full-stack. Les textes personnels seront
    complétés plus tard.
  </p>
  <div class="mt-10 flex flex-wrap gap-4">
    <a
      href={projets}
      class="rounded-md bg-accent px-5 py-3 text-sm font-medium text-accent-fg no-underline hover:bg-accent-hover hover:text-accent-fg"
    >
      Voir les projets
    </a>
    <a
      href={`${home}#contact`}
      class="rounded-md border border-border px-5 py-3 text-sm font-medium text-fg no-underline hover:border-accent hover:text-accent"
    >
      Contact
    </a>
  </div>
</section>
