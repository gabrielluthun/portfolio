---
import SkillTabs from "./SkillTabs";
import type { Locale } from "../../i18n/locales";
import { t } from "../../i18n/t";

type Props = {
  locale?: Locale;
};

const { locale = "fr" } = Astro.props;
const education =
  locale === "fr"
    ? [
        {
          title: "Concepteur Développeur d'Applications",
          organization: "Simplon Hauts-de-France",
          period: "Sept. 2024 — Juil. 2025",
          result: "Admis",
        },
        {
          title: "BTS",
          organization: "Lycée Gaston Berger, Lille",
          period: "2017 — 2019",
          result: "Admis",
        },
        {
          title: "Bac Pro Gestion Administration",
          organization: "Lycée les Hauts de Flandre, Seclin",
          period: "2014 — 2017",
          result: "Admis avec mention",
        },
      ]
    : [
        {
          title: "Application Designer and Developer",
          organization: "Simplon Hauts-de-France",
          period: "Sep 2024 — Jul 2025",
          result: "Passed",
        },
        {
          title: "Higher Technician Diploma",
          organization: "Lycée Gaston Berger, Lille",
          period: "2017 — 2019",
          result: "Passed",
        },
        {
          title: "Vocational Baccalaureate in Administration",
          organization: "Lycée les Hauts de Flandre, Seclin",
          period: "2014 — 2017",
          result: "Passed with honors",
        },
      ];
---

<section id="profil" class="mx-auto max-w-6xl scroll-mt-28 px-4 pt-16 pb-8 sm:px-6 sm:pt-24 sm:pb-10">
  <h2 class="mb-10">{t(locale, "about.title")}</h2>
  <div class="grid grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-10">
    <article class="rounded-xl border border-border bg-bg-muted/60 p-6 sm:p-8">
      <p class="m-0 mb-8 text-fg">
        {t(locale, "about.bio").split("\n\n").map((paragraph) => (<><span>{paragraph}</span><br /><br /></>))}
   
      </p>
      <ul class="m-0 mb-8 flex list-none flex-col gap-3 p-0 text-sm">
        <li class="flex flex-wrap gap-x-2 gap-y-1">
          <span class="font-medium text-fg">E-mail :</span>
          <a href="mailto:gabriel.luthun@gmail.com">gabriel.luthun@gmail.com</a>
        </li>
        <li class="flex flex-wrap gap-x-2 gap-y-1">
          <span class="font-medium text-fg">{t(locale, "about.location")} :</span>
          <span class="text-fg-muted">Lille, Hauts-de-France</span>
        </li>
      </ul>

    </article>

    <div>
      <h3 class="mb-4">{t(locale, "about.education")}</h3>
      <ul class="m-0 flex list-none flex-col gap-3 p-0">
        {
          education.map((item) => (
            <li class="rounded-xl border border-border bg-bg-muted/40 p-5 sm:p-6">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div class="min-w-0 flex-1">
                  <p class="m-0 mb-1 font-heading text-base font-semibold text-fg">
                    {item.title}
                  </p>
                  <p class="m-0 mb-2 text-sm text-accent">{item.organization}</p>
                  {"period" in item ? (
                    <p class="m-0 text-sm text-fg-muted">{item.period}</p>
                  ) : null}
                </div>
                {"result" in item ? (
                  <p class="m-0 shrink-0 text-sm font-medium text-fg-muted">{item.result}</p>
                ) : null}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <!-- Skills – section pleine largeur sous la grille -->
  <div class="mt-24">
    <SkillTabs client:idle locale={locale} />
  </div>
</section>
