---
import ProjectGrid from "../projects/ProjectGrid.tsx";
import { getFeaturedProjects } from "../../services/project.service";
import { sitePath } from "../../lib/site-path";

const projects = getFeaturedProjects();
const catalogHref = sitePath("projets", import.meta.env.BASE_URL);
const home = sitePath("", import.meta.env.BASE_URL);
---

<section id="projets" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-16 sm:px-6 sm:py-24">
  <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
    <h2>Projets phares</h2>
    <a
      href={catalogHref}
      class="rounded-md border border-border px-4 py-2 text-sm font-medium text-fg no-underline hover:border-accent hover:text-accent"
    >
      Tous les projets
    </a>
  </div>
  <ProjectGrid client:visible projects={projects} baseUrl={import.meta.env.BASE_URL} />
  <div class="mt-10 flex justify-center sm:mt-12">
    <a
      href={`${home}#contact`}
      class="rounded-md border border-border px-4 py-2.5 text-sm font-medium text-fg no-underline hover:border-accent hover:text-accent sm:px-5 sm:py-3"
    >
      Parlons de votre besoin
    </a>
  </div>
</section>
