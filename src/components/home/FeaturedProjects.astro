---
import ProjectGrid from "../projects/ProjectGrid.tsx";
import { getFeaturedProjects } from "../../services/project.service";
import { sitePath } from "../../lib/site-path";
import { withLocalePath, type Locale } from "../../i18n/locales";
import { t } from "../../i18n/t";

type Props = {
  locale?: Locale;
};

const { locale = "fr" } = Astro.props;
const projects = getFeaturedProjects(undefined, locale);
const projectsPath = locale === "fr" ? "projets" : "projects";
const localizedProjectsPath = withLocalePath(locale, projectsPath);
const projectsId = locale === "fr" ? "projets" : "projects";
const catalogHref = sitePath(withLocalePath(locale, projectsPath), import.meta.env.BASE_URL);
const home = sitePath(withLocalePath(locale, ""), import.meta.env.BASE_URL);
---

<section id={projectsId} class="mx-auto max-w-6xl scroll-mt-24 px-4 py-16 sm:px-6 sm:py-24">
  <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
    <h2>{t(locale, "featured.title")}</h2>
    <a
      href={catalogHref}
      class="rounded-md border border-border px-4 py-2 text-sm font-medium text-fg no-underline hover:border-accent hover:text-accent"
    >
      {t(locale, "featured.all")}
    </a>
  </div>
  <ProjectGrid client:visible projects={projects} baseUrl={import.meta.env.BASE_URL} locale={locale} projectsBasePath={localizedProjectsPath} />
  <div class="mt-10 flex justify-center sm:mt-12">
    <a
      href={`${home}#contact`}
      class="rounded-md border border-border px-4 py-2.5 text-sm font-medium text-fg no-underline hover:border-accent hover:text-accent sm:px-5 sm:py-3"
    >
      {t(locale, "featured.cta")}
    </a>
  </div>
</section>
