---
import ThemeToggle from "./ThemeToggle.tsx";
import { sitePath } from "../lib/site-path";

const home = sitePath("", import.meta.env.BASE_URL);
const projets = sitePath("projets", import.meta.env.BASE_URL);
---

<header
  class="sticky top-0 z-50 border-b border-border/80 bg-bg/80 backdrop-blur-md"
  transition:persist="site-header"
  transition:animate="none"
>
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-4 gap-y-3 px-4 py-3 sm:px-6 sm:py-4">
    <a
      href={home}
      class="font-heading shrink-0 text-lg font-semibold tracking-tight text-fg no-underline hover:text-accent sm:text-xl"
    >
      Gabriel Luthun
    </a>
    <nav
      aria-label="Navigation principale"
      class="flex min-w-0 flex-wrap items-center justify-end gap-0.5 sm:gap-2"
    >
      <a href={home} class="rounded-md px-2 py-1.5 text-xs text-fg-muted no-underline hover:text-fg sm:px-3 sm:py-2 sm:text-sm">Accueil</a>
      <a href={`${home}#a-propos`} class="rounded-md px-2 py-1.5 text-xs text-fg-muted no-underline hover:text-fg sm:px-3 sm:py-2 sm:text-sm">À propos</a>
      <a href={projets} class="rounded-md px-2 py-1.5 text-xs text-fg-muted no-underline hover:text-fg sm:px-3 sm:py-2 sm:text-sm">Projets</a>
      <a href={`${home}#contact`} class="rounded-md px-2 py-1.5 text-xs text-fg-muted no-underline hover:text-fg sm:px-3 sm:py-2 sm:text-sm">Contact</a>
      <ThemeToggle client:load />
    </nav>
  </div>
</header>
