---
import ThemeToggle from "../ThemeToggle.tsx";
import MobileMenu from "./MobileMenu.tsx";
import LocaleSwitch from "./LocaleSwitch.astro";
import type { Locale } from "../../i18n/locales";

type Props = {
  home: string;
  locale: Locale;
  pathname: string;
};

const { home, locale, pathname } = Astro.props;
---

<div class="site-header__actions">
  <LocaleSwitch locale={locale} pathname={pathname} />
  <ThemeToggle client:load locale={locale} />
  <MobileMenu client:load home={home} locale={locale} />
</div>
