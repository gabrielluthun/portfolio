---
import { getPrimaryNavLinks } from "./nav-links";
import type { Locale } from "../../i18n/locales";

type Props = {
  home: string;
  locale: Locale;
};

const { home, locale } = Astro.props;
const links = getPrimaryNavLinks({ home, locale });
---

<nav aria-label={locale === "fr" ? "Navigation principale" : "Main navigation"} class="site-header__nav">
  <span class="site-header__pill" hidden></span>
  {
    links.map((link) => (
      <a href={link.href} data-nav={link.key}>
        {link.label}
      </a>
    ))
  }
</nav>
